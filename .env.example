# Postgres (docker compose up -d)
DATABASE_URL=postgres://platter:platter@localhost:5433/platter

# Flagsmith - Settings > SDK Keys in your environment
# Server-side environment key (starts with "ser."). Server only.
FLAGSMITH_SERVER_KEY=
# Client-side environment key. Safe for the browser.
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_ID=
# Organisation API token for the Admin API (feature console, experiment results). Server only, never commit.
FLAGSMITH_ADMIN_API_KEY=
# Flagsmith project id and environment key, used to build dashboard links and Admin API calls
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_KEY=
# Defaults to Flagsmith Cloud
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1/
# Created by npm run flagsmith:setup
FLAGSMITH_EXPERIMENT_ID=
